{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.swingtradinglog.com" }],
      "destination": "https://swingtradinglog.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/trade-pulse",
      "schedule": "0 11 * * 1-5"
    }
  ]
}
