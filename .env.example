# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics 4 (production only)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# EODHD market data (server-only)
EODHD_API_KEY=

# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=SwingTradingLog Feedback

# Resend (recommended — no Gmail App Password): https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=SwingTradingLog <onboarding@resend.dev>

ADMIN_EMAILS=nicksofficialindia@gmail.com

# Optional: override share-trade token signing (defaults to anon key)
# SHARE_TRADE_SECRET=
